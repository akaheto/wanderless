{
  "name": "wanderless",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:data": "tsx scripts/build-reference-data.ts",
