{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pytest*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run type-check*)",
      "Bash(npm run test*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.*)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) uv --directory backend run ruff format \"$f\" 2>&1 || true ;; esac"
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx|*.css) (cd frontend && npx prettier --write \"$f\") 2>&1 || true ;; esac"
          },
          {
            "type": "command",
            "command": "echo 'File changed: run /code-audit and /security-scan before marking the task complete' >&2"
          }
        ]
      }
    ]
  }
}
